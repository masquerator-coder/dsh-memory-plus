{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "lib-core",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "types": []
  },
  "include": [
    "src/model/**/*.ts",
    "src/storage/store.ts",
    "src/engines/**/*.ts",
    "src/service.ts"
  ]
}
